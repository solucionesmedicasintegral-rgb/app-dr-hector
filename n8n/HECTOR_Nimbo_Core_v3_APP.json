    {
      "parameters": {
        "jsCode": "const items=$input.all();\nlet req={};\ntry{req=$('Normalizar Request APP').first().json||{}}catch(e){try{req=$('Datos Prueba').first().json||{}}catch(e2){req={}}}\nconst modalidad=String(req.modalidad||'presencial').toLowerCase();\nconst duracionMin=Number(req.duracion||60);\nconst TZ='-06:00', now=new Date();\nconst wh={1:{start:15,end:20},2:{start:15,end:20},3:{start:9,end:14},4:{start:15,end:20},5:{start:9,end:14},6:{start:9,end:14}};\nconst busy=[];\nfor(const item of items){\n const j=item.json||{};\n const ss=j.consultation_schedules||j['horarios de consulta']||j.horarios_de_consulta;\n if(Array.isArray(ss)){for(const s of ss){const a=s.starts_at||s.comienza_en,b=s.ends_at||s.termina_en;if(a&&b)busy.push({start:new Date(a),end:new Date(b)});}continue;}\n if(j.start?.date&&j.end?.date){const a=new Date(`${j.start.date}T00:00:00${TZ}`),b=new Date(`${j.end.date}T00:00:00${TZ}`);busy.push({start:a,end:new Date(b.getTime()-1000)});continue;}\n if(j.start?.dateTime&&j.end?.dateTime)busy.push({start:new Date(j.start.dateTime),end:new Date(j.end.dateTime)});\n}\nconst pad=n=>String(n).padStart(2,'0');\nconst key=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;\nconst zoned=(k,h)=>new Date(`${k}T${pad(h)}:00:00${TZ}`);\nconst occupied=(a,b)=>busy.some(x=>a<x.end&&b>x.start);\nconst seen=new Set(), pref=[], other=[];\nfunction add(a,b,k,h,bucket){if(a<=now||occupied(a,b))return;const id=`${k}-${h}`;if(seen.has(id))return;seen.add(id);bucket.push({fecha:k,hora:`${pad(h)}:00`,inicio_iso:a.toISOString(),fin_iso:b.toISOString()});}\nfor(let d=0;d<60;d++){\n const base=new Date();base.setHours(0,0,0,0);base.setDate(base.getDate()+d);\n const day=base.getDay();if(!wh[day])continue;\n const k=key(base), w=wh[day];\n if(modalidad==='virtual'){const a=zoned(k,20),b=new Date(a.getTime()+duracionMin*60000);add(a,b,k,20,pref);}\n for(let h=w.start;h<w.end;h++){const a=zoned(k,h),b=new Date(a.getTime()+duracionMin*60000);add(a,b,k,h,other);}\n}\nconst horarios=(modalidad==='virtual'?[...pref.slice(0,5),...other]:other).slice(0,15);\nreturn [{json:{ok:true,modalidad,duracion:duracionMin,total_ocupados_detectados:busy.length,total_disponibles:horarios.length,horarios}}];"
      },
